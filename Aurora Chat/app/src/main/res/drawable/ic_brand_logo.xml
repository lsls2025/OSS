<?xml version="1.0" encoding="utf-8"?>
<!--
  品牌标识（矢量版）。

  为什么不用 mipmap/ic_launcher：那套 PNG 最高只有 192×192，引导页按 104dp 显示时
  在 xxhdpi 以上设备需要 300px 左右，被放大后必然发虚。这里按同一形状矢量重绘，
  任何密度都不会糊。

  形状与配色沿用现有图标（白色底 + 实心对话气泡 + 气泡内反色圆点），
  只把位图换成路径，不改变品牌观感。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 对话气泡（主体） -->
    <path
        android:pathData="M27,33 h48 a12,12 0 0 1 12,12 v18 a12,12 0 0 1 -12,12 h-18 l-9,9 v-9 h-21 a12,12 0 0 1 -12,-12 v-18 a12,12 0 0 1 12,-12 z"
        android:fillColor="#16181D" />
    <!-- 气泡内圆点（反色，表示"有内容"） -->
    <path
        android:pathData="M54,57 m-8,0 a8,8 0 1 0 16,0 a8,8 0 1 0 -16,0"
        android:fillColor="#FFFFFF" />
</vector>
