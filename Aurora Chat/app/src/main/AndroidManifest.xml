<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- 卸载其它应用的前置权限：Android 10(API 29) 起，targetSdk>=29 的应用若没有它，
         Intent.ACTION_DELETE 卸载「非本应用」的包会被系统静默忽略——不抛异常、不弹框，
         代码看起来「调用成功」，屏幕上却什么都没有。卸载本应用自己不需要它，
         这正是「删自己行、删微信不行」的原因。（normal 级权限，安装即授予，无需运行时申请） -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".AuroraChatApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_app_icon"
        android:roundIcon="@drawable/ic_app_icon"
        android:label="Aurora Chat"
        android:supportsRtl="true"
        android:theme="@style/Theme.AuroraChat"
        android:usesCleartextTraffic="true"
        android:manageSpaceActivity=".CacheManagerActivity"
        tools:replace="android:icon,android:roundIcon">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 第三方授权 deep link：aurora://oauth/authorize?client_id=...&app_name=...&scopes=... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="aurora"
                    android:host="oauth"
                    android:pathPrefix="/authorize" />
            </intent-filter>
            <!-- 系统分享接收：其他 App 分享文本/图片/文件时可选 Aurora Chat 接收（多 data 为 OR 匹配） -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/*" />
            </intent-filter>
        </activity>

        <!-- ========== 动态图标 alias（保留 MAIN/LAUNCHER 以供运行时切换） ========== -->

        <activity-alias
            android:name=".MainActivity_WeChat"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/icon_wechat"
            android:roundIcon="@mipmap/icon_wechat"
            android:label="微信">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivity_QQ"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/icon_qq"
            android:roundIcon="@mipmap/icon_qq"
            android:label="QQ">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivity_QianWen"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/icon_qianwen"
            android:roundIcon="@mipmap/icon_qianwen"
            android:label="千问">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivity_ZeroTermux"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/icon_zerotermux"
            android:roundIcon="@mipmap/icon_zerotermux"
            android:label="ZeroTermux">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivity_Computer"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/icon_computer"
            android:roundIcon="@mipmap/icon_computer"
            android:label="计算机">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivity_KuaiShou"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/icon_kuaishou"
            android:roundIcon="@mipmap/icon_kuaishou"
            android:label="快手">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".TcpService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
        <service
            android:name=".KeepAliveService"
            android:exported="false" />
        <service
            android:name=".AiKeepAliveService"
            android:exported="false" />
        <receiver
            android:name=".KeepAliveReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.aurora.chat.KEEPALIVE_CHECK" />
            </intent-filter>
        </receiver>
        <!-- AI 工具审批通知的「批准/拒绝」按钮回传（显式 Intent,无需 intent-filter） -->
        <receiver
            android:name=".AgentApprovalReceiver"
            android:exported="false" />

        <service
            android:name=".DownloadService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
        <service
            android:name=".DownloadFloatingService"
            android:exported="false" />
        <service
            android:name=".PrivacyFloatingService"
            android:exported="false" />
        <service
            android:name=".PrivacyAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
        <service
            android:name=".UploadService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
        <service
            android:name=".UploadFloatingService"
            android:exported="false" />

        <activity
            android:name=".CacheManagerActivity"
            android:exported="false"
            android:theme="@style/Theme.AuroraChat"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.WebViewActivity"
            android:exported="false"
            android:theme="@style/Theme.AuroraChat" />
        <activity
            android:name=".ui.server.TerminalActivity"
            android:exported="false"
            android:theme="@style/Theme.AuroraChat"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
